# Frontend
# Optional. Falls back to the public Base Sepolia RPC when unset.
# Free tiers: https://www.alchemy.com or https://www.quicknode.com
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=

# TokenFactory on Base Sepolia, deployed + verified 2026-08-31.
NEXT_PUBLIC_TOKEN_FACTORY_ADDRESS=0x2DbD6C4e499577056712d2D802EF13060CF157AF

# Contracts (only needed for deploy + verification, not for the frontend)
# RPC for deploys: same Alchemy/QuickNode endpoint works.
BASE_SEPOLIA_RPC_URL=
# Free key: https://basescan.org/myapikey (Basescan API account)
BASESCAN_API_KEY=
# Wallet private key that signs the deploy — never commit this.
DEPLOYER_PRIVATE_KEY=
